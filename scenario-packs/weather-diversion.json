        },
        {
          "type": "phrase",
          "label": "Diverting to Hadley",
          "value": "",
          "patterns": [
            "divert(ing)? to hadley|hadley"
          ],
          "required": true
        },
        {
          "type": "phrase",
          "label": "Reason (weather)",
          "value": "",
          "patterns": [
            "weather"
          ],
          "required": false
        }
      ],
      "cautions": []
    },
    {
      "kind": "call",
      "station": "London Information",
      "atc": "{cs}, London Information, roger, report your position and estimate for Hadley.",
